{
  "expo": {
    "name": "Cv Builder",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cvbuilder",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
  "expo-router",
  "expo-font",
  "expo-web-browser",
  [
    "expo-splash-screen",
    {
      "image": "./assets/images/ssplash.png",
      "imageWidth": 360,
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    }
  ]
],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ae164cd-3c11-4701-9a8f-7c428fc6068a"
      }
    },
    "android": {
      "package": "com.sphesihleshelembe.cvbuilder",
      "versionCode": 3
    }
  }
}
